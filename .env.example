# Create an app at https://www.strava.com/settings/api and set its
# "Authorization Callback Domain" to localhost (or your deployed domain).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Encrypts the session cookie that holds your Strava tokens. Any random string
# of 32+ characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. The public URL of the app, only needed behind a proxy or when the
# request origin isn't the address people actually visit.
# APP_URL=https://strava-export.example.com
